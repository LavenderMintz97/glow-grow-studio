---
import "../styles/global.css";

const whatsappLink = "https://wa.me/60104675275";

const navItems = [
  ["About", "about"],
  ["Activities", "activities"],
  ["Who It's For", "who-its-for"],
  ["What to Expect", "what-to-expect"],
  ["Community Moments", "community-moments"],
  ["FAQ", "faq"],
];

const heroCards = [
  ["Casual Wellness Badminton", "Friendly rallies, gentle sweat, easy laughs."],
  ["Beginner-Friendly Fitness", "Simple movement for energy and confidence."],
  ["Social Wellness Meetups", "Warm conversations without pressure."],
  ["Move at Your Pace", "Come as you are and start small."],
];

const audiences = [
  "People who want to restart movement gently",
  "Beginners who feel shy joining sports groups",
  "Working adults who want healthier routines",
  "People who want to meet new friends",
  "People interested in casual networking",
  "People who enjoy badminton, simple workouts, walks, wellness, or social activities",
  "People who want community without pressure",
];

const activities = [
  ["Casual Wellness Badminton", "Friendly games for beginners and casual players who want to move, sweat, laugh, and meet people in a relaxed setting.", "Friendly group session"],
  ["Beginner-Friendly Fitness Session", "Simple movement sessions for people who want to rebuild energy, consistency, and confidence without pressure.", "Simple movement reset"],
  ["Social Wellness Meetups", "Small gatherings for conversations, lifestyle sharing, wellness ideas, and meaningful connection.", "Conversation-led gathering"],
  ["Community Moments", "Ad hoc activities such as walks, board games, casual hangouts, content days, or personal growth sharing.", "Flexible community day"],
];

const benefits = [
  "Move without pressure",
  "Meet people naturally",
  "Build social confidence",
  "Create healthier routines",
  "Feel welcomed as a beginner",
  "Grow gently through consistency",
  "Enjoy casual networking without hard selling",
];

const expectations = [
  "Friendly beginner-level environment",
  "Comfortable sportswear is enough",
  "Bring water",
  "No need to be athletic",
  "Come alone or bring a friend",
  "Sessions are casual and people-first",
  "You can ask questions before joining",
];

const moments = [
  ["Event photos", "Small-group activities and warm community snapshots", "moment-event", "/images/community/Event%20Photo.jpeg"],
  ["Badminton photos", "Casual games, shared movement, and friendly rallies", "moment-badminton", "/images/community/Badminton%20Photo.jpeg"],
  ["Group activity photos", "Walks, hangouts, sharing days, and gentle growth moments", "moment-group", "/images/community/Group%20Activity%20Photo.jpeg"],
];

const quotes = [
  "I came alone but felt welcomed.",
  "It felt casual, friendly, and not intimidating.",
  "A simple way to move, meet people, and reset after work.",
];

const faqs = [
  ["Do I need to be fit to join?", "No. Sessions are designed to be approachable, beginner-friendly, and easy to join at your own pace."],
  ["Can beginners join?", "Yes. Beginners are warmly welcome, especially if you have felt nervous joining sports or social groups before."],
  ["Can I come alone?", "Yes. Many people join because they want a simple way to meet others naturally."],
  ["What should I bring?", "Wear comfortable sportswear, bring water, and come with an open mind. Specific session details can be shared before you join."],
  ["Is this a formal club?", "No. Glow & Grow Circle is a personal community initiative with a casual, people-first rhythm."],
  ["Is this only about sports?", "No. Sports and movement help people connect, but the circle also includes wellness, conversations, networking, and personal growth."],
  ["Can I bring a friend?", "Yes. You can come alone or bring someone who would enjoy a warm, beginner-safe space."],
  ["How do I join the next session?", "Send a message through the contact button and ask about the next available session."],
  ["Is there any pressure to buy anything?", "No. Glow & Grow Circle is community-first. Any wellness, beauty, or lifestyle recommendations are optional and shared only when relevant."],
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Glow & Grow Circle is a beginner-friendly personal community for casual sports, wellness activities, warm connection, networking, and gentle growth."
    />
    <meta
      name="keywords"
      content="Glow & Grow Circle, badminton community, wellness activities, beginner friendly sports, casual networking, personal growth community"
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://glow-grow-studio.pages.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Glow & Grow Circle" />
    <meta
      property="og:description"
      content="Move freely, meet naturally, and grow gently through casual sports, wellness activities, and meaningful everyday connection."
    />
    <meta property="og:url" content="https://glow-grow-studio.pages.dev/" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Glow & Grow Circle | Move Freely. Meet Naturally. Grow Gently.</title>
    <link rel="icon" href="/favicon.svg" />
    <style>
      .moment-card {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        background-image: none !important;
      }

      .moment-card img {
        position: absolute;
        inset: 0;
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }

      .moment-card::after {
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(180deg, rgba(17, 24, 22, 0.05), rgba(17, 24, 22, 0.58));
        content: "";
      }
    </style>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Glow & Grow Circle",
        "url": "https://glow-grow-studio.pages.dev/",
        "description": "A personal community initiative for casual sports, wellness activities, warm connection, casual networking, and everyday growth."
      }
    </script>
  </head>
  <body>
    <header class="site-header" aria-label="Site header">
      <a class="brand" href="#top" aria-label="Glow & Grow Circle home">
        <span class="brand-badge">GG</span>
        <span>
          <strong>Glow & Grow Circle</strong>
          <small>Move Freely. Meet Naturally. Grow Gently.</small>
        </span>
      </a>

      <nav aria-label="Primary navigation">
        {navItems.map(([label, target]) => <a href={`#${target}`}>{label}</a>)}
      </nav>

      <a class="header-cta" href={whatsappLink} target="_blank" rel="noopener noreferrer">
        Join Next Session
      </a>
    </header>

    <main id="top">
      <section class="hero-section">
        <div class="hero-copy">
          <p class="eyebrow">Independent beginner-friendly community</p>
          <h1>Glow & Grow Circle</h1>
          <p class="tagline">Move Freely. Meet Naturally. Grow Gently.</p>
          <p class="hero-summary">
            A beginner-friendly community space for casual sports, wellness activities, warm conversations, and everyday growth where you can move at your own pace and meet people naturally.
          </p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button primary" href={whatsappLink} target="_blank" rel="noopener noreferrer">Join the Next Session</a>
            <a class="button secondary" href="#what-to-expect">See What to Expect</a>
          </div>
          <dl class="hero-proof" aria-label="Community tone">
            <div><dt>Beginner</dt><dd>safe pace</dd></div>
            <div><dt>People</dt><dd>first sessions</dd></div>
            <div><dt>Gentle</dt><dd>growth rhythm</dd></div>
          </dl>
        </div>

        <div class="hero-collage" aria-label="Glow & Grow Circle visual collage">
          <div class="collage-photo main-photo"></div>
          <div class="collage-photo side-photo"></div>
          <div class="soft-orb orb-one"></div>
          <div class="soft-orb orb-two"></div>
          <div class="session-card session-card-main">
            <span>Next Session</span>
            <strong>Casual movement + warm hellos</strong>
            <p>Come alone or bring a friend.</p>
          </div>
          <div class="session-card session-card-mini">
            <span>Welcome note</span>
            <strong>No pressure. No performance.</strong>
          </div>
          <div class="floating-grid">
            {heroCards.map(([title, copy]) => <article><strong>{title}</strong><p>{copy}</p></article>)}
          </div>
        </div>
      </section>

      <section id="about" class="section welcome-section">
        <p class="eyebrow">Welcome</p>
        <div class="split-section">
          <h2>You do not need to be athletic, outgoing, or already confident to join.</h2>
          <div class="copy-stack">
            <p>
              Glow & Grow Circle is created for everyday people who want a simple way to move, meet others, and feel part of something positive. Some people come for fitness. Some come for badminton. Some come because they want to expand their circle, network casually, or rebuild their social confidence.
            </p>
            <p>Whatever your reason, you are welcome here.</p>
            <p>
              Start small. Bring your water bottle. Wear something comfortable. Join one session, meet a few people, and let the connection grow naturally.
            </p>
          </div>
        </div>
      </section>

      <section class="section split-section definition-section">
        <div>
          <p class="eyebrow">What Is Glow & Grow Circle?</p>
          <h2>A personal community initiative for movement, wellness, and meaningful connection.</h2>
        </div>
        <div class="copy-stack feature-panel">
          <p>
            Glow & Grow Circle is designed for people who want to build healthier routines, meet new people, and grow socially in a relaxed, beginner-friendly environment.
          </p>
          <p>
            This is not about being the best player, the fittest person, or the loudest person in the room. It is about showing up, moving gently, connecting naturally, and building better days one small step at a time.
          </p>
        </div>
      </section>

      <section id="who-its-for" class="section">
        <div class="section-heading">
          <p class="eyebrow">Who It's For</p>
          <h2>A soft place to start, restart, or reconnect.</h2>
        </div>
        <div class="audience-grid">
          {audiences.map((item) => <article class="small-card"><span>For you</span><p>{item}</p></article>)}
        </div>
      </section>

      <section id="activities" class="section activities-section">
        <div class="section-heading">
          <p class="eyebrow">Activities</p>
          <h2>Casual ways to move, gather, and grow together.</h2>
        </div>
        <div class="activity-grid">
          {activities.map(([title, copy, format]) => (
            <article class="activity-card">
              <span>{format}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section soft-panel split-section">
        <div>
          <p class="eyebrow">Why Join</p>
          <h2>Feel supported while building simple, healthier rhythms.</h2>
        </div>
        <div class="benefit-list">
          {benefits.map((benefit) => <span>{benefit}</span>)}
        </div>
      </section>

      <section id="what-to-expect" class="section expectation-section">
        <div class="section-heading">
          <p class="eyebrow">What to Expect</p>
          <h2>Practical, low-pressure, and easy to join.</h2>
        </div>
        <div class="expect-grid">
          {expectations.map((item) => <article class="expect-card"><span>Good to know</span>{item}</article>)}
        </div>
      </section>

      <section class="section portfolio-section">
        <div class="portfolio-visual">
          <div class="portfolio-photo" aria-label="Community gathering moment"></div>
          <div class="story-card">
            <span>Independent platform</span>
            <strong>Built around people, lifestyle, growth, branding, and community-building.</strong>
          </div>
        </div>
        <div class="portfolio-copy">
          <p class="eyebrow">Personal Portfolio</p>
          <h2>Community-building as part of Vanessa / Hui Chen's own journey.</h2>
          <p>
            Glow & Grow Circle is also part of my personal journey in building community, wellness, content, digital marketing, and meaningful offline experiences. It brings together my interests in people, lifestyle, growth, branding, and community-building into one warm space.
          </p>
          <p>
            This website is my independent personal platform for shaping gentle real-world experiences, not another organization's official page.
          </p>
          <div class="portfolio-tags">
            <span>Community</span><span>Wellness</span><span>Content</span><span>Digital marketing</span><span>Offline experiences</span>
          </div>
        </div>
      </section>

      <section id="community-moments" class="section moments-section">
        <div class="section-heading">
          <p class="eyebrow">Community Moments</p>
          <h2>Small highlights, warm memories, and honest member notes.</h2>
        </div>
        <div class="moments-grid">
          {moments.map(([title, copy, className, imageSrc]) => (
            <article class={`moment-card ${className}`}>
              <img src={imageSrc} alt={`${title} from Glow & Grow Circle`} loading="lazy" />
              <span>{title}</span>
              <p>{copy}</p>
            </article>
          ))}
        </div>
        <div class="quote-grid">
          {quotes.map((quote) => <article><p>"{quote}"</p></article>)}
        </div>
      </section>

      <section id="faq" class="section faq-section">
        <div class="section-heading">
          <p class="eyebrow">FAQ</p>
          <h2>Questions that make joining feel easier.</h2>
        </div>
        <div class="faq-list">
          {faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
        </div>
      </section>

      <section id="contact" class="section final-cta">
        <p class="eyebrow">Ready?</p>
        <h2>Ready to move freely, meet naturally, and grow gently?</h2>
        <p>
          Start with one simple session. Come as you are, move at your pace, and let the connection grow naturally.
        </p>
        <a class="button primary" href={whatsappLink} target="_blank" rel="noopener noreferrer">
          Message Me to Join the Next Session
        </a>
      </section>
    </main>

    <footer>
      <div>
        <strong>Glow & Grow Circle</strong>
        <span>Move Freely. Meet Naturally. Grow Gently.</span>
      </div>
      <p>A personal community initiative for casual sports, wellness activities, warm connection, and everyday growth.</p>
    </footer>
  </body>
</html>
